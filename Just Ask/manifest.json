  "components": [
    {
      "name": "ActionLink",
      "group": "Actions",
      "summary": "The underlined SemiBold text link that ends a section (\"See the Question →\", \"Simple by Design →\", \"After the Yes: Guidance and Resources →\")."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "The primary campaign action (\"Just Ask\"): a blue, 8px-radius button with a SemiBold 16/24 label."
    },
    {
      "name": "Callout",
      "group": "Interior pieces",
      "summary": "A titled tip or note marked by closed brackets on both sides ([ … ]), with no fill, so it never reads as a card."
    },
    {
      "name": "CardGrid",
      "group": "Interior sections",
      "summary": "A grid of InfoCards under an accent rule, H2 and optional intro, with an optional closing button or closing pair."
    },
    {
      "name": "ClinicalQuestion",
      "group": "Homepage sections",
      "summary": "The exact clinical question in a pale-blue panel with an open blue bracket, beside an eyebrow, heading, short body, and an optional ActionLink and \"Copy the Qu…"
    },
    {
      "name": "ContactForm",
      "group": "Interior sections",
      "summary": "The Contact page: social links beside a form with validation states."
    },
    {
      "name": "CtaBand",
      "group": "Homepage sections",
      "summary": "The closing (or mid-page) campaign band on surface-inverse: a centered cta statement with lead words in sky, an optional question in sky, an optional body line…"
    },
    {
      "name": "DataBars",
      "group": "Interior pieces",
      "summary": "Proportional horizontal bars against a 100% track, with the value as text (The Diagnosis Gap)."
    },
    {
      "name": "FeaturedResource",
      "group": "Interior sections",
      "summary": "One highlighted Library item in a pale-blue panel: optional format tag, title, text, button, 4:3 preview image, with a white brain pattern."
    },
    {
      "name": "Hero",
      "group": "Homepage sections",
      "summary": "The campaign statement: \"More than / 40 million / Americans live with migraine\", the care-gap subtitle, a 100 × 3 rule and \"Led by:\" with the AHS logo, over th…"
    },
    {
      "name": "HomePage",
      "group": "Pages",
      "summary": "The homepage (content outline 0.0 Home), assembled only from the system's components in outline order:",
      "page": true
    },
    {
      "name": "IntroMedia",
      "group": "Homepage sections",
      "summary": "Rich text + campaign imagery: the consultation photo beside an accent rule, H2, short body and an ActionLink."
    },
    {
      "name": "ListBlock",
      "group": "Interior pieces",
      "summary": "List styles used inside TextSection and InfoCards: numbered, check, bullet, bullets in columns, and the list panel."
    },
    {
      "name": "PageHero",
      "group": "Interior sections",
      "summary": "The header of every interior page: optional eyebrow, H1, intro, and one of four layouts."
    },
    {
      "name": "PageNav",
      "group": "Interior sections",
      "summary": "End-of-page wayfinding on the step pages: a back card, the next-step card, and a \"Browse the Resource Library\" text link."
    },
    {
      "name": "PartnerAttribution",
      "group": "Homepage sections",
      "summary": "The partner section (\"Developed with clinicians who see patients every day\"): a centered introduction (H2, body, link), then one centered row of partner logos."
    },
    {
      "name": "PullQuote",
      "group": "Interior pieces",
      "summary": "A clinician quote with a blue quote mark and an attribution carrying its endnote."
    },
    {
      "name": "QuoteBand",
      "group": "Homepage sections",
      "summary": "A clinician quote in a pale-blue card over the consultation photo."
    },
    {
      "name": "References",
      "group": "Site chrome",
      "summary": "A numbered reference list for the page's endnotes: H2, a small muted note, then an ol in small with navy SemiBold numbers and a 44px hanging indent."
    },
    {
      "name": "ResourceCard",
      "group": "Cards",
      "summary": "A card that links to a group of After the Yes resources."
    },
    {
      "name": "ResourceLibrary",
      "group": "Interior sections",
      "summary": "The Resource Library template: three filters, a live results count, results grouped under headings, and an empty state."
    },
    {
      "name": "ResourceLink",
      "group": "Interior pieces",
      "summary": "A row link to one Library resource: title, format label in its tag color, arrow in a 32px blue circle; the whole row is the link."
    },
    {
      "name": "RichText",
      "group": "Interior sections",
      "summary": "Long-form copy for the legal pages and any WYSIWYG field, at the 720 measure."
    },
    {
      "name": "SiteFooter",
      "group": "Site chrome",
      "summary": "The campaign footer on surface-soft: logo, utility links, copyright and legal links."
    },
    {
      "name": "SiteHeader",
      "group": "Site chrome",
      "summary": "The campaign header: the Just Ask. logo on the left and the primary navigation on the right."
    },
    {
      "name": "StatisticGrid",
      "group": "Homepage sections",
      "summary": "A section of statistic cards: value (statistic, blue, -1px tracking), a 40 × 3 blue rule, description and endnote."
    },
    {
      "name": "StepCards",
      "group": "Interior sections",
      "summary": "Three numbered, linked cards for the After the Yes sequence."
    },
    {
      "name": "StepNav",
      "group": "Interior sections",
      "summary": "A three-step stepper placed right after the PageHero on the step pages: numbered circles joined by a 2px sky line; the current step is filled blue."
    },
    {
      "name": "TextSection",
      "group": "Interior sections",
      "summary": "The block for prose sections: accent rule, H2, copy, and options for lists, quotes, asides, resource links and cards."
    },
    {
      "name": "Timeline",
      "group": "Interior sections",
      "summary": "Ordered checkpoints as cards with a blue chevron to the next one (When to Check In)."
    },
    {
      "name": "TreatmentEvidence",
      "group": "Homepage sections",
      "summary": "A text-and-statistic band on surface-soft: H2, body and ActionLink beside one evidence statistic inside a pair of brackets."
    }
  ],
